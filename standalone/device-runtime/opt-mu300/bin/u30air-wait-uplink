#!/usr/bin/python3
# U30 Air managed startup v1
"""A bounded, read-only boot gate; release clients when routing/DNS settle.

Never starts/restarts services, enables a disabled VPN, changes routing, or reads
probe credentials. The gate releases clients on timeout so their own retry loops
remain available when cellular data is down. All subprocesses have time limits.
"""
import argparse
import http.client
import json
from pathlib import Path
import re
import socket
import subprocess
import time

ROOT = Path('/')
DNS_HOST = 'controlplane.tailscale.com'


def read(name):
    try:
        return (ROOT / name.lstrip('/')).read_text().strip()
    except OSError:
        return ''


def setting(path, key, default=''):
    match = re.search(r'^' + re.escape(key) + r'=[\t ]*[\'"]?([a-zA-Z0-9_-]+)', read(path), re.M)
    return match.group(1) if match else default


def run(args, timeout=1):
    try:
        return subprocess.run(args, text=True, capture_output=True, timeout=timeout)
    except (OSError, subprocess.TimeoutExpired):
        return None


def routes(family, table='main'):
    result = run(['ip', '-j', family, 'route', 'show', 'table', table, 'default'])
    if result is None or result.returncode:
        return []
    try:
        return json.loads(result.stdout)
    except ValueError:
        return []


class UnixHTTP(http.client.HTTPConnection):
    def connect(self):
        self.sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        self.sock.settimeout(self.timeout)
        self.sock.connect(str(ROOT / 'run/mu300-vpn/mihomo-control.sock'))


def controller_ready():
    conn = UnixHTTP('localhost', timeout=.5)
    try:
        conn.request('GET', '/version')
        response = conn.getresponse()
        response.read(4096)
        return response.status == 200
    except (OSError, http.client.HTTPException):
        return False
    finally:
        conn.close()


def path_ready():
    uplinks = routes('-4') + routes('-6')
    if not any(r.get('dev') not in (None, 'lo', 'tailscale0', 'mh-mu300') for r in uplinks):
        return False, 'physical default route'
    if setting('etc/mu300/vpn.conf', 'ENABLE', '0') == '1':
        iface = read('run/mu300-vpn/iface')
        if not re.fullmatch(r'[A-Za-z0-9_.-]{1,15}', iface):
            return False, 'VPN tunnel and IPv4 policy'
        if not any(r.get('dev') == iface for r in routes('-4', '2022')):
            return False, 'VPN IPv4 route'
        # The native daemon publishes iface after installing routes/DNS/Tailscale
        # rules, then publishes its IPv6 decision. Avoid connecting during that gap.
        decision = read('run/mu300-vpn/ipv6').split()
        if not decision or decision[0] not in ('yes', 'no'):
            return False, 'VPN IPv6 decision'
        if decision[0] == 'yes' and not any(r.get('dev') == iface for r in routes('-6', '2022')):
            return False, 'VPN IPv6 route'
        active = read('etc/mu300/vpn/active')
        if not re.fullmatch(r'[a-z0-9][a-z0-9-]{0,31}', active):
            return False, 'VPN profile'
        if setting('etc/mu300/vpn/profiles/' + active + '/meta', 'TYPE') == 'mihomo':
            if read('run/mu300-vpn/mihomo-profile') != active or not controller_ready():
                return False, 'mihomo controller'
    result = run(['getent', 'ahosts', DNS_HOST], timeout=1.5)
    if result is None or result.returncode or not result.stdout.strip():
        return False, 'DNS resolution'
    return True, 'uplink, configured VPN and DNS'


def wait_ready(timeout=45, interval=.5):
    start = time.monotonic()
    stable, last_reason = 0, 'uplink'
    while time.monotonic() - start < timeout:
        okay, last_reason = path_ready()
        stable = stable + 1 if okay else 0
        if stable >= 2:
            print(f'u30air-uplink: ready after {time.monotonic()-start:.1f}s ({last_reason})', flush=True)
            return True
        time.sleep(interval)
    print(f'u30air-uplink: released after {timeout:g}s timeout; waiting for {last_reason}; client retries remain enabled', flush=True)
    return False


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--timeout', type=float, default=45)
    args = parser.parse_args()
    if not 0 <= args.timeout <= 45:
        parser.error('timeout must be 0..45 seconds')
    wait_ready(args.timeout)
    # Network failure must not prevent clients or the local panel from starting.
    return 0


if __name__ == '__main__':
    raise SystemExit(main())
