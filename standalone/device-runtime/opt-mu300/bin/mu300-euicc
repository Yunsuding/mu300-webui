#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
mu300-euicc: Lightweight GSMA SGP.22 eUICC (9eSIM / ESTK / 5ber / Infineon / ECP) manager
for ZTE U30 Air (mu300) Ubuntu 24.04.

Bridges `lpac v2.3+` (`LPAC_APDU=at` over an in-memory POSIX PTY + `LPAC_HTTP=curl`)
directly to the Unisoc SIPC AT broker (`/run/mu300-at4` for SIM 2, `/run/mu300-at` for SIM 1)
with zero serial contention, zero resident memory overhead, and automatic ECP/Infineon
refreshFlag fallback.
"""

import argparse
import json
import os
import re
import subprocess
import sys
import threading
import time

try:
    import fcntl
except ImportError:
    fcntl = None

LPAC_BIN_CANDIDATES = (
    os.environ.get("MU300_LPAC_BIN", ""),
    "/opt/mu300/bin/lpac",
    "/usr/local/bin/lpac",
    "/usr/bin/lpac",
)
META_FILE = os.environ.get("MU300_EUICC_META", "/etc/mu300/euicc-meta.json")
SIM_CARDS_FILE = os.environ.get("MU300_SIM_CARDS", "/etc/mu300/sim-cards.json")
EUICC_LOCK_FILE = "/run/mu300/euicc.lock"

STAGE_TRANSLATIONS = {
    "es10x_init": "正在通过独立 AT 通道握手 eUICC 安全芯片...",
    "es9p_initiate_authentication": "正在连接运营商 SM-DP+ 服务器发起双向鉴权...",
    "es10b_authenticate_server": "芯片正在验证运营商服务器证书签名...",
    "es9p_authenticate_client": "正在向运营商提交芯片 EID 与挑战应答...",
    "es10b_prepare_download": "芯片正在准备安全下载通道...",
    "es9p_get_bound_profile_package": "正在从海外运营商下载加密 eSIM 号码包...",
    "es10b_load_bound_profile_package": "正在向白卡芯片分片写入 eSIM 配置...",
    "es10b_get_euicc_challenge_and_info": "正在读取芯片安全挑战随机数与证书信息...",
    "es10b_retrieve_notifications_list": "正在读取待上报运营商回执队列...",
    "es9p_handle_notification": "正在向运营商服务器同步激活/删除回执...",
}


def find_lpac_bin():
    for p in LPAC_BIN_CANDIDATES:
        if p and os.path.isfile(p) and os.access(p, os.X_OK):
            return p
    return ""


def atomic_write_json(path, obj, mode=0o600):
    parent = os.path.dirname(path)
    if parent:
        os.makedirs(parent, exist_ok=True)
    tmp = f"{path}.tmp.{os.getpid()}"
    with open(tmp, "w", encoding="utf-8", newline="\n") as f:
        json.dump(obj, f, ensure_ascii=False, indent=2)
        f.write("\n")
    try:
        os.chmod(tmp, mode)
    except OSError:
        pass
    os.replace(tmp, path)


def load_json_dict(path, default=None):
    if default is None:
        default = {}
    if os.path.exists(path):
        try:
            with open(path, "r", encoding="utf-8", errors="ignore") as f:
                data = json.load(f)
            if isinstance(data, dict):
                return data
        except Exception:
            pass
    return dict(default)


def mask_iccid(iccid):
    s = re.sub(r"[^0-9A-Fa-f]", "", str(iccid or "")).upper()
    if len(s) >= 12:
        return f"{s[:6]}••••••{s[-4:]}"
    return s


def mask_eid(eid):
    s = re.sub(r"[^0-9A-Fa-f]", "", str(eid or "")).upper()
    if len(s) >= 16:
        return f"{s[:8]}••••••{s[-6:]}"
    return s


